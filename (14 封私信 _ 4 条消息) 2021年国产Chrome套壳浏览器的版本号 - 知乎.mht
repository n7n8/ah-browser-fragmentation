------MultipartBoundary--ksvLdu1tWrBWn7pu3cRCO9NvMPQK3zpxX7uMV0xAxS----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://static.zhihu.com/heifetz/9165.216a26f4.354d4275364f5573d4c1.css

@charset "utf-8";

.MaxLength { color: var(--GBL05A); font-size: 14px; }

.MaxLength.is-error { color: var(--GRD03A); }

.Favlists-items { margin-bottom: 40px; max-height: 335px; min-height: 140px; overflow: hidden auto; }

.Favlists-item { -webkit-box-pack: justify; -webkit-box-align: center; align-items: center; border-bottom: 1px solid var(--GBK09A); display: flex; justify-content: space-between; padding: 8px 0px; }

.Favlists-itemInner { margin-right: var(--zhc-padding-horizontal,20px); overflow: hidden; }

.Favlists-itemName { display: flex; overflow: hidden; text-overflow: ellipsis; }

.Favlists-itemNameText { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.Favlists-itemIcon { fill: var(--GBL05A); margin-left: 6px; }

.Favlists-itemContent { color: var(--GBL05A); font-size: 14px; margin-top: 4px; }

.Favlists-updateButton { flex-shrink: 0; padding-left: 0px; padding-right: 0px; width: 76px; }

.Favlists-actions { padding: var(--zhc-padding-vertical,16px) var(--zhc-padding-horizontal,20px); }

.Favlists-actions, .Favlists-mobileActions { -webkit-box-pack: center; box-sizing: border-box; display: flex; justify-content: center; }

.Favlists-mobileActions { background: var(--GBK99A); border-top: 1px solid var(--GBK09A); bottom: 0px; left: 0px; padding: calc(var(--zhc-padding-vertical, 16px) - 4) var(--zhc-padding-horizontal,20px); position: fixed; width: 100%; }

.Favlists-mobileActions .Favlists-addButton:last-child:first-child { width: 100%; }

.Favlists-mobileActions .Button { -webkit-box-flex: 1; flex: 1 1 0%; }

.Favlists-mobileActions .Button:first-child:not(:last-child) { margin-right: 8px; }

.Favlist-emptyContent { -webkit-box-orient: vertical; -webkit-box-direction: normal; -webkit-box-pack: center; -webkit-box-align: center; align-items: center; display: flex; flex-direction: column; height: 100%; justify-content: center; }

.Favlist-emptyTip { color: var(--GBL05A); font-size: 15px; margin-top: 30px; }

.Favlists-addButton { width: 220px; }

.Favlists-addItem { margin-bottom: 8px; }

.Favlists-descritionInput, .Favlists-titleInput { height: auto; padding: 8px 12px; width: 100%; }

.Favlists-privacyOption { display: block; font-size: 14px; margin-bottom: 6px; overflow: auto; }

.Favlists-privacyOption--privacyDisable { color: var(--GBK07A); }

.Favlists-privacyOptionTips { color: var(--GBL05A); margin-left: 4px; }

.Favlists-privacyOptionRadio { appearance: none; background-clip: content-box; border: 2px solid var(--GBK09A); border-radius: 50%; display: inline-block; height: 14px; margin: 0px 4px 0px 0px; padding: 2px; transition: background-color, border-color 0.3s; vertical-align: middle; width: 14px; }

.Favlists-privacyOptionRadio:checked { background-color: var(--GBL01A); border-color: var(--GBL01A); }

.Favlists-privacyOptionRadio:focus { outline: none; }

