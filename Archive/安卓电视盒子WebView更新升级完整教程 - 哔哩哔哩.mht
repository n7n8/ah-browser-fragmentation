@charset "utf-8";

.v-img { position: relative; display: inline-flex; width: 100%; height: 100%; background-color: var(--graph_bg_regular); object-fit: cover; }

.v-img img { display: block; width: 100%; height: 100%; object-fit: inherit; }

.bili-header .animated-banner { position: absolute; inset: 0px; overflow: hidden; }

.bili-header .animated-banner > .layer { position: absolute; left: 0px; top: 0px; height: 100%; width: 100%; display: flex; align-items: center; justify-content: center; }

.bili-header .bili-header__banner .header-banner__inner { position: relative; width: 100%; max-width: 2078px; margin: 0px auto; }

@media (max-width: 1099.9px) {
  .bili-header .bili-header__banner .header-banner__inner { padding: 0px 56px; }
}

@media (min-width: 1100px) and (max-width: 1366.9px) {
  .bili-header .bili-header__banner .header-banner__inner { padding: 0px 56px; }
}

@media (min-width: 1367px) and (max-width: 1700.9px) {
  .bili-header .bili-header__banner .header-banner__inner { padding: 0px 64px; }
}

@media (min-width: 1701px) and (max-width: 2199.9px) {
  .bili-header .bili-header__banner .header-banner__inner { padding: 0px 96px; max-width: 2270px; }
}

@media (min-width: 2200px) {
  .bili-header .bili-header__banner .header-banner__inner { max-width: 2078px; }
}

.bili-header .bili-header__banner { position: relative; z-index: 0; display: flex; justify-content: center; margin: 0px auto; min-width: 1000px; min-height: 155px; height: 9.375vw; max-height: 240px; background-color: rgb(227, 229, 231); background-position: center 0px; background-size: cover; background-repeat: no-repeat; }

.bili-header .bili-header__banner .banner-img { position: absolute; object-fit: cover; }

.bili-header .bili-header__banner .header-banner__inner { display: flex; align-items: flex-end; }

.bili-header .bili-header__banner .header-banner__inner .inner-logo { margin-bottom: 10px; z-index: 1; display: inline-block; min-height: 60px; width: 180px; height: 50%; }

.bili-header .bili-header__banner .taper-line { position: absolute; top: 0px; left: 0px; z-index: 0; width: 100%; height: 100px; background: linear-gradient(rgba(0, 0, 0, 0.4), transparent); pointer-events: none; }

.bili-header .bili-header__banner .head-title { position: absolute; bottom: 25px; left: 380px; padding: 6px 10px; max-width: 350px; border-radius: 4px; background-color: rgba(47, 50, 56, 0.9); color: rgb(255, 255, 255); font-size: 14px; line-height: 20px; opacity: 0; transition: opacity 0.3s; }

.bili-header .bili-header__banner:hover .head-title { opacity: 1; }

.bili-header .bili-header__banner .head-logo { position: absolute; bottom: 10px; z-index: 1; min-height: 60px; width: 220px; height: 50%; }

.bili-header .bili-header__banner .logo-img { display: block; width: 162px; height: 78px; object-fit: contain; background: none !important; }

.bili-header .bili-header__banner .banner-link { position: absolute; top: 0px; left: 0px; z-index: 0; width: 100%; height: 100%; }

.bili-header .channel-icons { z-index: 0; display: flex; align-items: center; }

.bili-header .channel-icons .channel-icons__item { position: relative; display: flex; flex-direction: column; align-items: center; color: var(--text1); width: max-content; }

.bili-header .channel-icons .channel-icons__item .icon-bg { position: relative; display: flex; align-items: center; justify-content: center; margin-bottom: 6px; border-radius: 50%; transition: background-color 0.3s; }

.bili-header .channel-icons .channel-icons__item .icon-bg__dynamic-summary { background: var(--Cy5_u); }

.bili-header .channel-icons .channel-icons__item .icon-bg__dynamic-summary:hover { background: rgba(var(--Cy5_u_rgb),.8); }

.bili-header .channel-icons .channel-icons__item .icon-bg__dynamic-summary .icon-badge { position: absolute; top: -2px; right: -2px; width: 28px; height: 12px; }

.bili-header .channel-icons .channel-icons__item .icon-bg__dynamic { background-color: rgb(255, 146, 18); }

.bili-header .channel-icons .channel-icons__item .icon-bg__dynamic:hover { background: rgb(255, 158, 44); }

.bili-header .channel-icons .channel-icons__item .icon-bg__popular { background-color: rgb(240, 119, 117); }

.bili-header .channel-icons .channel-icons__item .icon-bg__popular:hover { background: rgb(243, 142, 140); }

.bili-header .channel-icons .channel-icons__item .icon-bg__channel { background: rgb(89, 202, 115); }

.bili-header .channel-icons .channel-icons__item .icon-bg__channel:hover { background: rgb(108, 208, 131); }

.bili-header .channel-icons .channel-icons__item .icon-bg--up { overflow: hidden; border-radius: 50%; }

.bili-header .channel-icons .channel-icons__item .icon-bg--up > img { border-radius: 50%; }

.bili-header .channel-icons .channel-icons__item .icon-bg--icon { width: 25px; height: 25px; }

