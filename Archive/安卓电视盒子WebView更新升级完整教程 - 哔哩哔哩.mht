@charset "utf-8";

.coin-popup { padding: 20px 0px 25px; display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; -webkit-box-align: center; align-items: center; }

.coin-popup__title { font-size: 16px; color: var(--text1); text-align: center; }

.coin-popup__close { cursor: pointer; position: absolute; right: 16px; top: 16px; width: 16px; height: 16px; display: flex; -webkit-box-pack: center; justify-content: center; -webkit-box-align: center; align-items: center; }

.coin-popup__close::after, .coin-popup__close::before { position: absolute; width: 20px; height: 1px; content: ""; display: block; background-color: var(--text3); }

.coin-popup__close::after { transform: rotate(45deg); }

.coin-popup__close::before { transform: rotate(-45deg); }

.coin-popup__content { display: flex; -webkit-box-pack: center; justify-content: center; }

.coin-popup__figure { position: relative; margin-top: 35px; margin-left: 8px; margin-right: 8px; width: 160px; height: 230px; border: 2px solid var(--line_regular); border-radius: 5px; background-repeat: no-repeat; background-position: 50% center; background-size: 122px auto; cursor: pointer; }

.coin-popup__figure.is-active { border-color: var(--brand_blue); }

.coin-popup__figure.is-active .coin-popup__figure__label { color: var(--brand_blue); }

.coin-popup__figure__pic { --animation-frame-width: 120px; --animation-frame-height: 206px; width: var(--animation-frame-width); height: var(--animation-frame-height); position: absolute; bottom: 10px; left: 50%; transform: translateX(-50%); overflow: hidden; }

@-webkit-keyframes coin-run-animation { 
  0% { transform: translateX(0px); }
  100% { transform: translateX(calc(var(--animation-frame-width)*-24)); }
}

@keyframes coin-run-animation { 
  0% { transform: translateX(0px); }
  100% { transform: translateX(calc(var(--animation-frame-width)*-24)); }
}

.coin-popup__figure__pic-img { width: calc(var(--animation-frame-width)*24); height: var(--animation-frame-height); will-change: transform; animation: 2s steps(24) 0s infinite normal none running coin-run-animation; }

.coin-popup__figure__label { text-align: left; font-size: 14px; line-height: 40px; position: absolute; left: 15px; top: 0px; color: var(--text2); }

.coin-popup__footer { display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; -webkit-box-align: center; align-items: center; margin-top: 25px; }

.coin-popup__footer p { font-size: 12px; color: var(--text3); margin-top: 10px; }

.creator-honor { width: 400px; border-radius: 12px; background-color: var(--bg1,#fff); overflow: hidden; }

.creator-honor__header { position: relative; box-sizing: border-box; height: 66px; }

.creator-honor__close { cursor: pointer; position: absolute; right: 12px; top: 12px; width: 24px; height: 24px; display: flex; -webkit-box-pack: center; justify-content: center; -webkit-box-align: center; align-items: center; }

.creator-honor__close::after, .creator-honor__close::before { position: absolute; width: 15px; height: 2px; content: ""; display: block; border-radius: 1px; background-color: var(--text2,#61666d); }

.creator-honor__close::after { transform: rotate(45deg); }

.creator-honor__close::before { transform: rotate(-45deg); }

.creator-honor__body { box-sizing: border-box; padding: 0px 24px 24px; gap: 24px; }

.creator-honor__badge, .creator-honor__body { display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; -webkit-box-align: center; align-items: center; }

.creator-honor__badge { gap: 16px; }

.creator-honor__badge-area { position: relative; width: 173px; height: 96px; display: flex; -webkit-box-pack: center; justify-content: center; -webkit-box-align: center; align-items: center; }

.creator-honor__badge-main { width: 96px; height: 96px; border-radius: 24px; -webkit-user-drag: none; }

.creator-honor__badge-left { position: absolute; left: 7px; bottom: 13px; width: 27px; height: 27px; -webkit-user-drag: none; }

.creator-honor__badge-right { position: absolute; right: 8px; top: -1px; width: 30px; height: 27px; -webkit-user-drag: none; }

.creator-honor__text { display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; -webkit-box-align: center; align-items: center; gap: 8px; max-width: 100%; }

.creator-honor__title { font-size: 16px; font-weight: 500; line-height: 22px; color: var(--text1,#18191c); text-align: center; word-break: break-word; }

.creator-honor__user { display: flex; -webkit-box-orient: horizontal; -webkit-box-direction: normal; flex-direction: row; -webkit-box-pack: center; justify-content: center; -webkit-box-align: center; align-items: center; gap: 4px; max-width: 100%; font-size: 12px; line-height: 17px; }

.creator-honor__user-avatar { width: 16px; height: 16px; border-radius: 50%; -webkit-box-flex: 0; flex: 0 0 auto; -webkit-user-drag: none; }

.creator-honor__user-name { color: var(--text1,#18191c); }

.creator-honor__user-name, .creator-honor__user-subline { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.creator-honor__user-subline { color: var(--text3,#9499a0); }

.creator-honor__info { -webkit-box-orient: vertical; flex-direction: column; gap: 12px; }

.creator-honor__desc, .creator-honor__info { display: flex; -webkit-box-direction: normal; -webkit-box-align: center; align-items: center; width: 100%; }

.creator-honor__desc { position: relative; padding: 16px; border-radius: 8px; background-color: var(--bg2,#f6f7f8); -webkit-box-orient: horizontal; flex-direction: row; -webkit-box-pack: center; justify-content: center; }

.creator-honor__desc, .creator-honor__desc-deco { box-sizing: border-box; }

.creator-honor__desc-deco { position: absolute; top: 0px; width: 25px; height: 93px; border: 2px solid rgb(255, 176, 39); }

.creator-honor__desc-deco--left { left: 0px; }

.creator-honor__desc-deco--right { right: 0px; }

.creator-honor__desc-text { width: 320px; max-width: 100%; font-size: 14px; line-height: 24px; color: var(--text2,#61666d); text-align: center; word-break: break-word; }

.creator-honor__bottom { font-size: 12px; line-height: 17px; color: var(--text3,#9499a0); text-align: center; }

.reaction-item { display: flex; -webkit-box-align: center; align-items: center; padding: 16px 0px; box-shadow: 0 -.5px 0 0 var(--line_regular) inset; }

.reaction-item__face { width: 40px; height: 40px; flex-shrink: 0; border-radius: 50%; overflow: hidden; margin-right: 16px; cursor: pointer; }

.reaction-item__main { -webkit-box-flex: 1; flex: 1 1 0%; overflow: hidden; }

.reaction-item__name { font-size: 15px; font-style: normal; font-weight: 500; line-height: 21px; color: var(--text1); cursor: pointer; }

.reaction-item__action { display: inline-block; font-weight: 400; margin-left: 6px; }

.reaction-item__desc { color: var(--text3); margin-top: 4px; font-size: 13px; }

.reaction-item__follow { margin-left: 32px; flex-shrink: 0; }

.reaction-list { padding: 12px 56px 0px; }

.reaction-list__empty, .reaction-list__loading { display: flex; -webkit-box-pack: center; justify-content: center; -webkit-box-align: center; align-items: center; padding: 60px 0px; font-size: 13px; color: var(--text3); }

.reaction-list__loading-text { margin-left: 12px; }

.reaction-list__loadmore { height: 40px; width: 100%; }

.reaction-list__nomore { padding: 20px 0px; font-size: 13px; color: var(--text3); text-align: center; }

.opus-collection { position: absolute; left: -8px; top: 0px; border-radius: 6px; background: var(--bg1_float); width: 480px; transform: translateX(-100%); filter: drop-shadow(rgba(0, 0, 0, 0.16) 0px 4px 10px) drop-shadow(rgba(0, 0, 0, 0.08) 0px 0px 2px); }

.opus-collection__header { display: flex; box-shadow: 0 -.5px 0 0 var(--line_regular) inset; padding: 10px 16px; }

.opus-collection__info { -webkit-box-flex: 1; flex: 1 1 0%; min-width: 0px; }

.opus-collection__title { font-size: 17px; color: var(--text1); font-weight: 500; margin-bottom: 2px; }

.opus-collection__action svg { vertical-align: top; transition: transform 0.3s, -webkit-transform 0.3s; }

.opus-collection__summary { display: inline-flex; -webkit-box-align: center; align-items: center; gap: 2px; max-width: 100%; font-size: 12px; color: var(--text2); cursor: pointer; }

.opus-collection__summary span { min-width: 0px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.opus-collection__summary svg { flex-shrink: 0; vertical-align: bottom; }

.opus-collection__summary svg:nth-child(3) { transform: scale(0.8); }

.opus-collection__summary:hover { color: var(--brand_blue); }

.opus-collection__action { margin-left: 24px; font-size: 13px; color: var(--text2); background-color: transparent; outline: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; cursor: pointer; }

.opus-collection__action.reverse svg { transform: rotate(180deg); }

.opus-collection__action.reverse:hover { color: var(--brand_blue); }

.opus-collection__content { overflow-y: auto; min-height: 117px; max-height: 400px; }

.opus-collection__item { --collection-item-bg: var(--bg1_float); padding: 14px 16px; cursor: pointer; font-size: 15px; color: var(--text1); position: relative; background-color: var(--collection-item-bg); }

.opus-collection__item.active { --collection-item-bg: #e8f5fc; color: var(--brand_blue); background-color: var(--collection-item-bg); }

.opus-collection__item.active .opus-collection__item__title-text { font-weight: 500; }

.opus-collection__item:hover { color: var(--brand_blue); }

.opus-collection__item__title { width: calc(100% - 80px); }

.opus-collection__item__title-text { display: -webkit-box; font-weight: 400; line-height: 22px; max-height: 44px; overflow: hidden; vertical-align: middle; word-break: break-word; -webkit-line-clamp: 2; }

.opus-collection__item__title-tag { display: inline-flex; width: 60px; height: 16px; font-size: 10px; font-weight: 400; border-radius: 2px; border: .5px solid var(--brand_pink,#f69); -webkit-box-orient: horizontal; -webkit-box-direction: normal; flex-direction: row; -webkit-box-align: center; align-items: center; -webkit-box-pack: center; justify-content: center; color: var(--brand_pink,#f69); vertical-align: middle; }

.opus-collection__item__pubtime { position: absolute; right: 16px; top: 50%; font-size: 20px; transform-origin: right top; transform: scale(0.5) translateY(-50%); color: var(--text3); text-align: right; }

.ring-progress { position: absolute; }

.side-toolbar__box { padding: 12px 6px; }

.side-toolbar__box, .side-toolbar__btn { border-radius: 6px; background-color: var(--bg1); }

.side-toolbar__btn { cursor: pointer; width: 58px; height: 58px; margin-top: 6px; padding: 0px 17px; display: flex; -webkit-box-align: center; align-items: center; box-sizing: border-box; font-size: 12px; color: var(--text1); }

.side-toolbar__btn.backtop { transition: transform 0.3s, opacity 0.3s, -webkit-transform 0.3s; opacity: 0; pointer-events: none; }

.side-toolbar__btn.backtop span { margin-top: 10px; position: relative; }

.side-toolbar__btn.backtop span .backtop__icon { width: 15px; height: 8px; position: absolute; display: block; top: -11px; left: 4px; }

.side-toolbar__top { margin-bottom: 6px; }

.side-toolbar__audit-btn, .side-toolbar__top { background-color: var(--bg1); border-radius: 6px; }

.side-toolbar__audit-btn { cursor: pointer; width: 58px; height: 58px; margin-top: 6px; display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; -webkit-box-align: center; align-items: center; -webkit-box-pack: center; justify-content: center; box-sizing: border-box; color: var(--text3); }

.side-toolbar__audit-btn svg { width: 24px; height: 24px; color: var(--graph_icon); }

.side-toolbar__audit-btn__text { user-select: none; margin-top: 2px; font-size: 12px; line-height: 14px; }

.side-toolbar__audit-btn:hover, .side-toolbar__audit-btn:hover svg { color: var(--brand_blue); }

.side-toolbar__bottom { position: fixed; bottom: 20px; }

.side-toolbar.transition .side-toolbar__btn { transition: 0.2s; }

.side-toolbar.on .side-toolbar__btn.backtop { opacity: 1; pointer-events: all; transform: translateY(0px); cursor: pointer; }

.side-toolbar__action { position: relative; cursor: pointer; width: 46px; display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; -webkit-box-align: center; align-items: center; -webkit-box-pack: justify; justify-content: space-between; color: var(--text3); }

.side-toolbar__action__combosvga { position: absolute; left: -12px; top: -23px; width: 70px; height: 70px; }

.side-toolbar__action + .side-toolbar__action { margin-top: 16px; }

.side-toolbar__action__text { user-select: none; margin-top: 4px; font-size: 12px; line-height: 14px; }

.side-toolbar__action svg { width: 24px; height: 24px; color: var(--graph_icon); }

.side-toolbar__action.is-active, .side-toolbar__action.is-active svg { color: var(--brand_blue); }

.side-toolbar__action.hide-icon svg { opacity: 0; }

.side-toolbar__action.shaking svg { animation-name: shaking; animation-duration: 1s; animation-timing-function: ease-in-out; animation-iteration-count: infinite; }

.side-toolbar__action.collection { width: 58px; height: 58px; box-sizing: border-box; -webkit-box-pack: center; justify-content: center; }

