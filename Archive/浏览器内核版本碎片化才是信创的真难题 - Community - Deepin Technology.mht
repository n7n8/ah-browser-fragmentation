  d-header .d-menu-li .d-sub-menu { position: unset; }
  d-header .d-menu-li .d-sub-menu > li.has-child-menu { position: relative; }
  d-header .d-menu-li .d-sub-menu > li.has-child-menu a::after { float: none; position: absolute; margin-left: 0.5rem; }
  d-header .d-menu-li a::before { display: none; }
  d-header .d-menu-li .vaild-link, d-header .d-menu-li .valid-link { color: rgb(44, 167, 248); }
  d-header .d-menu-li .d-sub-menu-btn { width: 40px; position: absolute; right: 1rem; top: 0px; color: rgb(255, 255, 255); font-size: 1.5rem; }
