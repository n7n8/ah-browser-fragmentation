d-header .d-sub-menu > li.has-child-menu.hover > a::after { opacity: 0; transform: rotate(90deg); }

d-header .d-sub-menu > li.has-child-menu.hover > .d-child-menu { max-height: 500px; }

d-header .d-sub-menu > li:not(.has-child-menu):hover > a { color: rgb(44, 167, 248); }

