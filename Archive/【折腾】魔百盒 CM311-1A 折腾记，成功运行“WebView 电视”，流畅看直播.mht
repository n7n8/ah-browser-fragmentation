  .new_bg_color .comment__push__ph_popover .comment__push__ph_popover_tail { background-color: rgb(56, 56, 56); }
}

.comment__push__toast { position: fixed; top: 50%; left: 0px; right: 0px; width: 75vw; transform: translateY(-50%); margin: 0px auto; z-index: 9999; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 500; }

.comment__push__toast_text { color: var(--weui-WHITE); padding: 12px 20px; background-color: rgb(76, 76, 76); border-radius: 8px; }

.js_voice_anchor { position: absolute; z-index: 1000; right: 2px; bottom: calc((var(--INPUT-LINE-HEIGHT-EM) - 36px) / 2); width: 36px; height: 36px; display: flex; align-items: center; overflow: visible; pointer-events: none; }

.js_voice_anchor > * { pointer-events: auto; }

.comment__push__wrp { padding: 8px 20px; }

.comment__push__wrp.need_safe_bottom { padding-bottom: calc(8px + env(safe-area-inset-bottom)); }

.comment__push__inner { flex: 1 1 0%; min-width: 0px; border-radius: 4px; background-color: rgb(255, 255, 255); }

.comment__push__container .comment__push__input::placeholder { color: rgba(0, 0, 0, 0.3); font-size: 16px; }

.comment__push__send { font-size: 14px; line-height: 2; width: auto; padding: 0px 12px; margin-left: 8px; margin-top: 6px; }

.comment__push__emoji, .comment__push__keyboard { width: 28px; height: 28px; }

.comment__push__extend { padding-bottom: 0px; }

.comment__push__extend .weui-wa-hotarea::after { min-width: 100%; min-height: 44px; padding: 0px 4px; }

@media (prefers-color-scheme: dark) {
  .comment__push__inner { background-color: rgb(44, 44, 44); }
  .comment__push__container .comment__push__input::placeholder { color: rgba(255, 255, 255, 0.3); }
