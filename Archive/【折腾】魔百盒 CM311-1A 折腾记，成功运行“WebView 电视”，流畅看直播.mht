.wx_search_highlight { animation: 2s ease-in-out 0.15s 1 normal none running searchHighlight; }

@-webkit-keyframes searchHighlight { 
  0% { background-color: rgba(0, 0, 0, 0); }
  30% { background-color: rgba(7, 193, 96, 0.3); }
  70% { background-color: rgba(7, 193, 96, 0.3); }
  100% { background-color: rgba(0, 0, 0, 0); }
}

@keyframes searchHighlight { 
  0% { background-color: rgba(0, 0, 0, 0); }
  30% { background-color: rgba(7, 193, 96, 0.3); }
  70% { background-color: rgba(7, 193, 96, 0.3); }
  100% { background-color: rgba(0, 0, 0, 0); }
}

