.comment__push__img_container { display: flex; align-items: flex-start; flex-direction: row; transition: height 0.3s; overflow: scroll hidden; height: 0px; padding-right: 8px; }

.comment__push__img_container .comment__push__img_item { position: relative; }

.comment__push__img_container .comment__push__img_item.loading .comment__push__input__img { border-radius: 4px !important; background-image:  !important; background-position-x:  !important; background-position-y:  !important; background-repeat:  !important; background-attachment:  !important; background-origin:  !important; background-clip:  !important; background-color:  !important; background-size: 16px auto !important; }

.comment__push__img_container .comment__push__img_item::before { content: ""; height: 20px; background: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0)); display: block; position: absolute; top: 0px; left: 8px; right: 0px; border-radius: 4px 4px 0px 0px; pointer-events: none; }

.comment__push__img_container .delete_img { width: 20px; height: 20px; position: absolute; top: 0px; left: 8px; }

.comment__push__img_container .delete_img::before { content: ""; position: absolute; width: 12px; height: 1px; top: 50%; left: 4px; transform: translateY(-0.5px) rotate(45deg); background-color: rgb(255, 255, 255); }

.comment__push__img_container .delete_img::after { content: ""; position: absolute; width: 12px; height: 1px; top: 50%; left: 4px; transform: translateY(-0.5px) rotate(-45deg); background-color: rgb(255, 255, 255); }

.comment__push__img_container::-webkit-scrollbar { display: none; opacity: 0; visibility: hidden; }

.comment__push__voice_container { display: flex; padding: 0px 8px 8px; }

.comment__push__voice_container > * + * { margin-left: 8px; }

.comment__push__voice_container .delete .weui-icon-clear { color: var(--weui-FG-4); width: 1.6em; height: 1.6em; }

.comment__push__voice_container .loading { display: flex; align-items: center; }

.comment__push__voice_container .loading .weui-loading { font-size: 10px; width: 1.2em; height: 1.2em; }

.comment__push .comment__push__upper_container { display: flex; align-items: flex-end; }

.comment__push .comment__push__upper_container .weui-pc-popover__wrp { position: absolute; top: -4px; left: 16px; }

.comment__push .comment__push__upper_container .weui-pc-popover__wrp.gold .weui-pc-popover { background: linear-gradient(to right, rgb(255, 255, 255) 0%, rgb(255, 247, 237) 100%); }

@media (prefers-color-scheme: dark) {
  .comment__push .comment__push__upper_container .weui-pc-popover__wrp.gold .weui-pc-popover { background: linear-gradient(to right, rgb(56, 56, 56) 0%, rgb(69, 58, 44) 100%); }
}

