.comment__emoji__panel .comment_primary_emotion_item:hover { background-color: transparent; }

.comment__push__container__horizontal .comment__push__wrp, .comment__push__container__horizontal .comment__emoji__panel { padding-left: 120px; padding-right: 120px; }

@media (prefers-color-scheme: dark) {
  .comment__push__wrp { --transparent-caret-color: #2c2c2c00; background-color: rgb(30, 30, 30); }
  .comment__push__input_wrp { background-color: rgb(42, 42, 42); }
  .comment__push__input_wrp .comment__push__input { color: rgba(255, 255, 255, 0.8); }
  .comment__push__input_wrp .comment__push__input::placeholder { color: rgba(255, 255, 255, 0.5); font-size: 15px; }
}

.text-placeholder { z-index: 99; position: absolute; display: flex; top: -0.15em; left: 8px; color: var(--weui-FG-2); width: calc(100% - 16px); }

.text-placeholder .comment__push__placeholder { display: flex; align-items: center; width: 100%; }

.text-placeholder .comment__push__placeholder .comment__push__placeholder__nickname { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 40%; }

.text-placeholder .comment__push__placeholder .comment__push__placeholder__text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 0; }

.text-placeholder .comment__push__placeholder .js_icon_channels_input { width: 1.6em !important; height: 1.6em !important; }

.js_icon_channels_input { margin-right: 0.4em; margin-top: -0.25em; width: 1.6em !important; height: 1.6em !important; }

.comment__push__ph_popover { position: absolute; bottom: 100%; left: 0px; z-index: 1000; }

.comment__push__ph_popover .comment__push__ph_popover_body { display: flex; align-items: center; padding: 10px 12px; background-color: rgb(255, 255, 255); border-radius: 8px; box-shadow: rgba(0, 0, 0, 0.1) 0px 0px 25px; backdrop-filter: blur(50px); }

@media (prefers-color-scheme: dark) {
  .comment__push__ph_popover .comment__push__ph_popover_body { background-color: var(--weui-BG-5); }
  .new_bg_color .comment__push__ph_popover .comment__push__ph_popover_body { background-color: rgb(56, 56, 56); }
}

.comment__push__ph_popover .comment__push__ph_popover_icon { flex-shrink: 0; width: 16px; height: 16px; margin-right: 4px; background-image: url("data:image/svg+xml,%3Csvg width='16' height='16' viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11.0069 2.23502C11.3176 1.69956 12.1017 1.69944 12.4123 2.23502L15.2779 7.17598C15.574 7.68656 15.574 8.31345 15.2779 8.82405L12.4123 13.765C12.1017 14.3006 11.3176 14.3006 11.0069 13.765L7.99968 8.58073L4.99314 13.765C4.68243 14.3006 3.89834 14.3006 3.58768 13.765L0.722082 8.82405C0.425988 8.31344 0.425957 7.68658 0.722082 7.17598L3.58768 2.23502C3.89834 1.69945 4.68241 1.69953 4.99314 2.23502L7.99968 7.41865L11.0069 2.23502Z' fill='%2310AEFF'/%3E%3C/svg%3E"); background-size: contain; background-repeat: no-repeat; }

.comment__push__ph_popover .comment__push__ph_popover_text { font-size: 14px; line-height: 19.6px; color: rgba(0, 0, 0, 0.55); white-space: nowrap; }

@media (prefers-color-scheme: dark) {
  .comment__push__ph_popover .comment__push__ph_popover_text { color: rgba(255, 255, 255, 0.5); }
}

.comment__push__ph_popover .comment__push__ph_popover_tail { width: 14px; height: 5px; margin-left: 9px; background-color: rgb(255, 255, 255); mask-image: url("data:image/svg+xml,%3Csvg width='14' height='5' viewBox='0 0 14 5' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 0L7 7.62939e-06L14 0C11.2663 0 9.13317 5 7 5C4.86684 5 2.73367 0 0 0Z' fill='white'/%3E%3C/svg%3E"); mask-size: contain; mask-repeat: no-repeat; }

@media (prefers-color-scheme: dark) {
