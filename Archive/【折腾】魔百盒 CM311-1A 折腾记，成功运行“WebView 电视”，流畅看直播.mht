.reward_list-wrp { --weui-cellPaddingLR: 16px; }

.reward_list-wrp .reward_list_tips { text-align: left; font-size: 14px; color: var(--weui-FG-1); padding: 8px var(--weui-cellPaddingLR); }

.reward_list-wrp .reward_list.weui-cells.weui-cells { margin: 0px; }

.reward_list-wrp .reward_list.weui-cells.weui-cells::before { display: none; }

.reward_list-wrp .reward_list.weui-cells.weui-cells::after { border-bottom: 0px; background-color: var(--weui-FG-3); height: 0.5px; font-size: 40px; left: calc(var(--weui-cellPaddingLR) + 1em + 12px); }

.reward_list-wrp .reward_list .weui-cell.weui-cell { padding-top: 12px; padding-bottom: 12px; }

.reward_list-wrp .reward_list .weui-cell.weui-cell::before { border-top: 0px; background-color: var(--weui-FG-3); height: 0.5px; font-size: 40px; left: calc(var(--weui-cellPaddingLR) + 1em + 12px); }

.reward_list-wrp .reward_list .weui-cell.weui-cell .weui-cell__hd.weui-cell__hd { padding-right: 12px; display: flex; align-items: center; }

.reward_list-wrp .reward_list .weui-cell.weui-cell .weui-cell__ft.weui-cell__ft { padding-left: 16px; }

.reward_list-wrp .reward_list .account-avatar-wrp { --border-radius: 100%; position: relative; border-radius: var(--border-radius); overflow: hidden; mask-image: -webkit-linear-gradient(var(--weui-BG-2),var(--weui-BG-2)); }

.reward_list-wrp .reward_list .account-avatar-wrp .account-avatar { display: block; font-size: 40px; width: 1em; height: 1em; border-radius: var(--border-radius); vertical-align: top; background-size: cover; background-position: 50% 50%; }

.reward_list-wrp .reward_list .account-avatar-wrp.private { --border-radius: 4px; }

.reward_list-wrp .reward_list .account-avatar-wrp.with-mask .account-avatar { filter: blur(7px); }

.reward_list-wrp .reward_list .account-avatar-wrp.with-mask::before { content: " "; position: absolute; inset: 0px; background: rgba(0, 0, 0, 0.08); border-radius: var(--border-radius); }

.reward_list-wrp .reward_list .account-avatar-wrp.with-mask::after { content: " "; position: absolute; inset: 0px; background: rgba(210, 210, 210, 0.38); border-radius: var(--border-radius); }

.reward_list-wrp .reward_list .account-text { min-height: calc(2.55294em + 2px); display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }

.reward_list-wrp .reward_list .account-text .account-nickname-wrp { max-width: 100%; }

.reward_list-wrp .reward_list .account-text .account-nickname-wrp .account-nickname { width: auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; overflow-wrap: normal; font-weight: 400; min-width: 1.5em; }

.reward_list-wrp .reward_list .account-text .account-nickname-wrp .account-nickname em { font-style: normal; color: var(--weui-BRAND); }

.reward_list-wrp .reward_list .account-text .account-nickname-wrp .weui-icon-mp, .reward_list-wrp .reward_list .account-text .account-nickname-wrp .weui-icon-ph { flex-shrink: 0; width: 1.6em; height: 1.6em; margin-left: 2px; }

.reward_list-wrp .reward_list .account-text .mutual-follow { font-size: 12px; color: var(--weui-BRAND); margin-left: 8px; white-space: nowrap; }

.reward_list-wrp .reward_list .account-text .weui-cell__desc { padding-top: 2px; font-size: 14px; font-weight: 400; line-height: 20px; color: var(--weui-FG-0); white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }

.reward_list-wrp .reward_list .account-text .account-money { font-family: WeChatSansSS-Medium; position: relative; padding-left: 0.7em; }

.reward_list-wrp .reward_list .account-text .account-money .account-yen { font-size: 20px; position: absolute; left: 0px; top: 5px; }

.reward_list-wrp .reward_list .account-text .account-money .account-yen.android { top: 3px; }

.reward_list-wrp .reward_list .reward_list_toogle_avatar:active { opacity: 0.5; }

.reward_list-wrp .reward_list-loadmore { margin-top: 12px; text-align: center; color: var(--weui-FG-2); }

.reward_list_dialog .weui-half-screen-dialog { padding: 0 env(safe-area-inset-right) 0 env(safe-area-inset-left); }

.reward_list_dialog .weui-half-screen-dialog__hd { padding: 0px 24px; }

.reward_list_dialog .weui-half-screen-dialog__hd__side .weui-btn_icon { left: 0px; }

.reward_list_dialog .weui-half-screen-dialog__bd { padding-bottom: env(safe-area-inset-bottom) !important; }

.reward_list_dialog .reward_list_dialog_hd { display: flex; justify-content: center; align-items: center; gap: 16px; }

.reward_list_dialog .reward_list_dialog_hd .reward_list_dialog_hd_item { line-height: 63px; padding: 0px 4px; color: var(--weui-FG-1); font-weight: 400; position: relative; white-space: nowrap; }

.reward_list_dialog .reward_list_dialog_hd .reward_list_dialog_hd_item.active { color: var(--weui-FG-0); font-weight: 500; }

.reward_list_dialog .reward_list_dialog_hd .reward_list_dialog_hd_item.active::after { content: " "; position: absolute; left: 0px; right: 0px; bottom: 17px; background-color: var(--weui-FG-0); height: 2px; }

.reward_list_dialog .at-dialog_tips { margin-top: 160px; color: var(--weui-FG-2); text-align: center; }
