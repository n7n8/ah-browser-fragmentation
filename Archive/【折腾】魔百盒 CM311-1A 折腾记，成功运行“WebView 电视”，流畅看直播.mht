.reward_skin_primary .reward_tips { margin: 0px 0px 15px; font-size: 16px; }

.reward_skin_primary .reward_tips::before, .reward_skin_primary .reward_tips::after { display: none; }

.reward_skin_primary .reward_user_tips.weui-loadmore { border-top-color: transparent; }

