  .reward_qrcode_img_wrp { width: 224px; height: 224px; margin: 1.8em auto; }
  .reward_access { line-height: 44px; font-size: 17px; }
  .icon-reward { width: 19px; height: 20px; vertical-align: -3px; }
}

.reward_area_primary .reward-avatar { border-radius: 4px; }

.reward_area_primary .reward-author { margin-top: 8px; font-size: 14px; }

@supports (-webkit-overflow-scrolling: touch) {
  .reward_button { font-weight: 700; }
}

