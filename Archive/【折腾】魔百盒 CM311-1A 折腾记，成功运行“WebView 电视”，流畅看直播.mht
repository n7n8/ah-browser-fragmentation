.feedback_dialog_radius_tail .feedback_dialog::before { display: none; }

.feedback_dialog_tail { pointer-events: none; position: absolute; margin-left: -4px; width: 8px; height: 8px; border-radius: 1.5px; background: var(--weui-BG-5); transform: rotate(45deg); inset: auto calc(7.4em + 12px) -3px auto; }

