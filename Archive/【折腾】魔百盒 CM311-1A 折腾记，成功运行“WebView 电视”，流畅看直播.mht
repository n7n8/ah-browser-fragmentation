.comment__push__inner { padding: var(--INPUT-PADDING) 0; overflow: hidden; }

.comment__push__embed_divider { display: none; position: relative; height: 0px; }

.comment__push__embed_divider::before { content: ""; position: absolute; left: 8px; right: 8px; top: 0px; height: 1px; background: var(--weui-FG-3); transform: scaleY(0.5); transform-origin: 0px 0px; pointer-events: none; }

.comment__push__outcontainer.has_embed .comment__push__inner { padding-bottom: 8px; }

.comment__push__outcontainer.has_embed .comment__push__embed_divider { display: block; height: 1px; margin-bottom: 8px; }

.comment__push__input_wrp { position: relative; flex: 1 1 0%; border-radius: 4px; background: rgb(255, 255, 255); }

.comment__push__input_wrp .comment__push__input__faker { min-height: var(--INPUT-LINE-HEIGHT-EM); word-break: break-all; opacity: 0; }

.comment__push__input_wrp .comment__push__input__faker, .comment__push__input_wrp .comment__push__input { box-sizing: border-box; padding: 0px 8px; line-height: 1.25; max-height: calc(var(--INPUT-LINE-HEIGHT-EM) * 7); }

.comment__push__input_wrp .comment__push__input { position: absolute; z-index: 999; inset: 0px; width: 100%; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; resize: none; font-size: inherit; font-family: inherit; outline: none; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); background-color: transparent; color: rgba(0, 0, 0, 0.8); text-size-adjust: inherit; }

.comment__push__input_wrp .comment__push__input::placeholder { color: rgba(0, 0, 0, 0.1); font-size: 15px; }

.comment__push__vote_tail { display: flex; align-items: center; font-size: 15px; line-height: 21px; padding: 0px 8px 8px; pointer-events: none; }

.comment__push__vote_tail__text { color: var(--expandInfo-FG); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; max-width: 100%; }

.comment__push__vote_tail__close { flex-shrink: 0; width: 16px; height: 16px; margin-left: 4px; color: var(--weui-FG-4); line-height: 0; cursor: pointer; pointer-events: auto; }

.comment__push__vote_tail__close svg { width: 16px; height: 16px; display: block; }

@supports (-webkit-overflow-scrolling: touch) {
  .comment__push__vote_tail__close svg { transform: translateY(-0.5px); }
}

.comment__push__vote_tail.is_forced .comment__push__vote_tail__close { display: none; }

.comment__push__input__img { height: 48px; width: 48px; margin: 0px 0px 8px 8px; border-radius: 4px; }

img.comment__push__input__img { object-fit: cover; }

.comment__push__extend { line-height: 36px; display: flex; align-items: center; margin-top: 8px; }

.comment__push__extend div { display: flex; }

.emoji-wrp { padding-top: 5px; }

.comment__push__extend-canusepic { padding-left: 30px; justify-content: space-between; }

.comment__push__input__counter { line-height: 1.4; font-size: 12px; color: var(--weui-FG-2); margin-top: 6px; display: flex; align-items: center; }

.comment__push__input__counter_warn { color: var(--weui-RED); }

.comment__push__cancel { color: var(--weui-LINK); font-size: 14px; font-weight: 500; margin-right: 12px; }

.comment__push__send { display: flex; align-items: center; justify-content: center; margin-left: 12px; line-height: 36px; width: 58px; height: 32px; text-align: center; font-weight: 500; border-radius: 6px; background-color: rgb(7, 193, 96); color: rgb(255, 255, 255) !important; }

.comment__push__send:active { background-color: rgb(6, 173, 86); color: rgb(229, 229, 229) !important; }

.comment__push__send.disabled { background: var(--weui-FG-5); color: var(--weui-FG-4) !important; }

.comment__push__emoji, .comment__push__keyboard, .comment__push__pictures, .comment__push__voice, .comment__push__poi, .comment__push__article_link { margin-left: 12px; width: 28px; height: 28px; background-color: currentcolor; font-size: 0px; color: var(--weui-FG-0) !important; }

.comment__push__pictures, .comment__push__voice, .comment__push__poi, .comment__push__article_link { margin-left: 8px; }

