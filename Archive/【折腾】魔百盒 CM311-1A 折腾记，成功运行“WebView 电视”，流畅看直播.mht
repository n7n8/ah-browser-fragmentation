.comment__push_danmu .comment__push__inner { background: transparent; padding: 0px; }

.comment__push_danmu .comment__push__input_wrp { background: rgba(237, 237, 237, 0.8); backdrop-filter: blur(40px); border-radius: 4px; margin: 0px; }

.comment__push_danmu .comment__push__input__faker, .comment__push_danmu .comment__push__input { padding: 10px 8px; }

.comment__push_danmu .comment__push__input { color: rgba(0, 0, 0, 0.9); }

