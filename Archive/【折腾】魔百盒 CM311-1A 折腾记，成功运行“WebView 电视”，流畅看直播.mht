  .pay__wecoin-edu-desc { color: rgba(255, 255, 255, 0.5); }
  .pay__wecoin-edu-desc span { color: rgba(255, 255, 255, 0.8); }
  .pay__wecoin-entry { background-color: rgb(32, 32, 32); }
  .pay__wecoin-entry::after { color: rgba(255, 255, 255, 0.5); }
  .pay__gift { background-color: rgb(32, 32, 32); }
  .pay__gift-bd { color: rgba(255, 255, 255, 0.3); }
  .pay__gift-send { background-color: rgb(42, 42, 42); color: rgba(255, 255, 255, 0.8); }
  .pay__gift-send-desc { color: rgba(255, 255, 255, 0.3); }
