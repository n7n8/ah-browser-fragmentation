.comment__push_danmu .comment__push__extend { padding-bottom: 4px; }

.comment__push_danmu .comment__push__send { border-radius: 6px; margin-left: 8px; line-height: 32px; }

.comment__push_danmu .comment__push__emoji, .comment__push_danmu .comment__push__keyboard, .comment__push_danmu .comment__push__pictures { margin-left: 8px; color: rgb(255, 255, 255); display: inline-block; vertical-align: middle; width: 28px; height: 28px; mask-size: cover; background: currentcolor; }

