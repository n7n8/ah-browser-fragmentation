textarea { resize: none; }

* { margin: 0px; padding: 0px; list-style: none; outline: none; word-break: break-all; }

body { text-size-adjust: 100%; overflow-wrap: break-word; line-height: 1.3; -webkit-tap-highlight-color: rgba(0, 0, 0, 0); font-family: "Droid Sans", "Droid Sans Fallback", STHeiti, Hei; background-color: rgb(255, 255, 255); font-size: 14px; color: rgba(0, 0, 0, 0.85); }

a { -webkit-tap-highlight-color: rgba(0, 0, 0, 0); text-decoration: none; color: rgba(0, 0, 0, 0.5); }

a:focus { -webkit-tap-highlight-color: rgba(0, 0, 0, 0); text-decoration: none; outline: none; }

input[type="text"]:focus, textarea:focus { outline: 0px; border: 0px; box-shadow: none; }

select, textarea, input { font-family: "Droid Sans", "Droid Sans Fallback", STHeiti, Hei; }

::-webkit-input-placeholder { color: rgba(0, 0, 0, 0.2); text-shadow: rgba(0, 0, 0, 0.2) 0px 0px 0px !important; }

