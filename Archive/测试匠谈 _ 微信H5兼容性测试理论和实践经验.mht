.video-com-wrap-container { width: 100%; height: 100%; position: relative; }

.video-com-wrap-container .video-player { width: 100%; height: 100%; object-fit: cover; }

.video-com-wrap-container .play-btn { width: 28.87px; height: 28.88px; position: absolute; inset: 0px; margin: auto; z-index: 100; cursor: pointer; display: flex; -webkit-box-pack: center; justify-content: center; -webkit-box-align: center; align-items: center; }

.video-com-wrap-container .play-btn img { width: 100%; height: 100%; object-fit: cover; }

.video-com-wrap-container .t-video-container { display: none; }

@media screen and (min-width: 1680px) {
  .video-com-wrap-container .play-btn { width: 37px; height: 37px; }
}

.video-player-modal-container .tea-dialog__inner { padding: 0px; position: relative; }

.video-player-modal-container .tea-dialog__header { display: none; }

.video-player-modal-container.is-pc .tea-dialog__body { width: 800px; height: 456px; }

.video-player-modal-container.is-pc .close-icon { width: 16px; height: 16px; cursor: pointer; position: absolute; right: -32px; }

.video-player-modal-container.is-mobile .tea-dialog__inner { min-width: unset; }

.video-player-modal-container.is-mobile .tea-dialog__body { width: 29rem; height: 16rem; }

.video-player-modal-container.is-mobile .close-icon { width: 1.33rem; height: 1.33rem; cursor: pointer; position: absolute; right: -2rem; }

.video-player-modal-container .modal-video-player { width: 100%; height: 100%; object-fit: cover; }

