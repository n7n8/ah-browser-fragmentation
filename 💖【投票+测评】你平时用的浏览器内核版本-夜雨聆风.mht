------MultipartBoundary--JOZN5Tg4UAdDICcG0kJuEGtoT9grLQ21twnbN1La4f----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://css.bim99.cn/yeyulingfeng/wp-content/plugins/xydown/css/style.css

@charset "utf-8";

.xydown { width: 615px; height: 45px; border: 1px dashed rgb(221, 221, 221); padding: 10px; margin: 10px 0px; line-height: 24px; border-radius: 3px; }

.xydown a { text-decoration: none; }

.xydown .downbtn { width: 88px; height: 50px; padding: 10px 35px 10px 55px; background: url("../img/down.jpg") repeat-x; color: rgb(255, 255, 255); font-size: 20px; display: block; }

.xydown .xydowntext { padding-left: 10px; font-size: 12px; }

.xydown_downlinks { width: 500px; }

.xydown_down_link { background: none 0px 0px repeat scroll rgb(255, 252, 239); border: 1px solid rgb(255, 187, 118); border-radius: 2px; color: rgb(219, 124, 34); font-size: 14px; margin-bottom: 10px; padding: 5px 10px; }

.xydown_views { color: red; }

.xydown_box { border-bottom: 1px solid rgb(170, 170, 170); padding: 10px 0px; }

.xydown_box_content { line-height: 18px; padding: 0px 0px 0px 10px; }

.xydown_box_content p { margin: 5px 0px; }

.xydown_box_content a { color: rgb(213, 78, 33); }

.xydown_box_content a:hover { color: rgb(29, 29, 29); }

.xydown_left { float: left; width: 320px; }

.xydown_right { width: 160px; float: right; margin: 0px auto; }

.xydown_right img { max-width: 160px; }

.xydown_notice { padding-top: 10px; text-align: center; }

#facebox .content { width: 600px; background: none 0px 0px repeat scroll rgb(224, 226, 228); color: rgb(51, 51, 51); }

#facebox .popup { border: 6px solid rgb(255, 125, 0); }

.downbtn { background: none 0px 0px repeat scroll rgb(27, 161, 226); border: 0px; border-radius: 2px; color: rgb(255, 255, 255); cursor: pointer; font-family: "Open Sans", "Hiragino Sans GB", "Microsoft YaHei", "WenQuanYi Micro Hei", Arial, Verdana, Tahoma, sans-serif; font-size: 14px; margin: -4px 20px 0px 0px; padding: 3px 30px; text-transform: none; text-decoration: none; }

.downlink a:link { color: rgb(255, 255, 255); }

.downlink a:visited { color: rgb(255, 255, 255); }

.downlink a:hover { color: rgb(255, 255, 255); }

.downlink a:active { color: rgb(255, 255, 255); }

.downbtn { background: none 0px 0px repeat scroll rgb(27, 161, 226); border: 0px; border-radius: 2px; cursor: pointer; font-family: "Open Sans", "Hiragino Sans GB", "Microsoft YaHei", "WenQuanYi Micro Hei", Arial, Verdana, Tahoma, sans-serif; font-size: 14px; margin: -4px 20px 0px 0px; padding: 3px 30px; color: rgb(255, 255, 255) !important; }

.yanshibtn { background: none 0px 0px repeat scroll rgb(211, 52, 49); border: 0px; border-radius: 2px; cursor: pointer; font-family: "Open Sans", "Hiragino Sans GB", "Microsoft YaHei", "WenQuanYi Micro Hei", Arial, Verdana, Tahoma, sans-serif; font-size: 14px; margin: -4px 20px 0px 0px; padding: 3px 30px; text-transform: none; text-decoration: none; color: rgb(255, 255, 255) !important; }

.downbtn a:hover, .yanshibtn a:hover { background: none 0px 0px repeat scroll rgb(155, 89, 182); border: 0px; border-radius: 2px; color: rgb(255, 255, 255); cursor: pointer; font-family: "Open Sans", "Hiragino Sans GB", "Microsoft YaHei", "WenQuanYi Micro Hei", Arial, Verdana, Tahoma, sans-serif; font-size: 14px; margin: -4px 20px 0px 0px; padding: 3px 30px; }

.paydown { margin-bottom: 20px; width: auto; border: 1px solid rgb(207, 207, 207); background: rgb(231, 231, 231); }

.paydown p { margin: 3px; padding: 3px 15px; border-bottom: 1px solid rgb(248, 248, 248); text-indent: 0px; }

.paydown p span { padding: 0px 5px; color: rgb(225, 77, 67); font-weight: bold; font-size: 120%; }

.paydown .down-title { float: left; padding-top: 15px; width: 9%; color: rgb(102, 102, 102); text-align: center; font-weight: bold; font-size: 16px; }

.paydown .down-detail { float: right; min-height: 140px; width: 90%; border-left: 1px solid rgb(238, 238, 238); background: rgb(255, 255, 255); }

.paydown p.down-ordinary { color: rgb(40, 183, 141); }

.paydown p.down-vip { color: rgb(225, 77, 67); }

.paydown p a { margin-left: 10px; font-weight: bold; text-decoration: none; }

.paydown p.down-tip { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.clear { clear: both; display: block; overflow: hidden; visibility: hidden; width: 0px; height: 0px; }
